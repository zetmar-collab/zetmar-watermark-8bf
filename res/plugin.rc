#include <winver.h>

// Opis wtyczki (PiPL) w formacie JSON, odczytywany przez Photoshopa/Elements z zasobow DLL.
JSON_PIPL JSON "pipl.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zetmar - Cyfrowy Przyjaciel"
            VALUE "FileDescription", "Podpis (Watermark) - filtr dla Photoshopa i Photoshop Elements"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ZetmarWatermark"
            VALUE "OriginalFilename", "ZetmarWatermark_64.8bf"
            VALUE "ProductName", "Podpis (Watermark)"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
